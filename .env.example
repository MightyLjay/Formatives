# Copy this file to `.env` and fill in your keys. `.env` is gitignored — never commit real keys.
# Loaded automatically by `market.probe` and `collector.monitor`.

ODDS_API_KEY=your-the-odds-api-key-here

# Only needed for the intel/ Claude layer (intel.extract). Optional.
# ANTHROPIC_API_KEY=your-anthropic-key-here
